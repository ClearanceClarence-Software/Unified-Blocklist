  },
  "bugs": "https://github.com/ClearanceClarence-Software/Unified-Blocklist/issues",
  "scripts": {
    "build": "wp-scripts build app/index.tsx",
    "start": "wp-scripts start app/index.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint:js": "wp-scripts lint-js app tests/e2e",
    "zip": "npm run build && node scripts/zip.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
